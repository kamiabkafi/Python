import random

target= random.randint(1, 100)

while True:
    user_choice=input("guess the number or Quit(Q): ")
    if(user_choice=="Q"):
        break
    user_choice= int(user_choice)
    if(user_choice==target):
        print("you have won!!!")
        break
    elif(user_choice<target):
        print("you are less than your target....")
    else:
        print("you are higher than your target....")  

print("______game over_______")